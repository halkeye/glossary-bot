DATABASE_URL=postgresql:///glossary-bot
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLASH_COMMAND=/glossary

# Read-only MCP server (python -m gloss.mcp_server)
MCP_AUTH_TOKEN=change-me
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
# Optional: comma-separated browser origins allowed to call /mcp
MCP_ALLOWED_ORIGINS=
MCP_USER_NAME=mcp
